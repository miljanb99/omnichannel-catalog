{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0&directConnection=true",
    "DatabaseName": "omnichannelCatalog",
    "BatchSize": 1000,
    "MaxAwaitTimeMs": 1000,
    "ChannelCapacity": 1000,
    "ParallelWorkers": 8,
    "ResumeTokenSaveInterval": 50,
    "MaxReconnectAttempts": 5,
    "ReconnectDelayMs": 2000
  },
  "ChannelSimulator": {
    "Enabled": true,
    "IntervalMs": 2000,
    "BatchSize": 200
  }
}